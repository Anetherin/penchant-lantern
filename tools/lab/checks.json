{
  "_readme": "Design intents as automated checks, run by tools/lab/check.mjs (format at the top of that file). Each check names an experiment (a spec in tools/lab/exp/ or an inline one) and what should hold. soft = an aim (WARN), not a rule (FAIL). Edit freely: thresholds here are first guesses, tune them as the design settles.",
  "checks": [
    {
      "id": "cycle1-winnable",
      "intent": "A sensible player clears the cycle-1 debt without game overs, well inside the 52-week schedule but not trivially fast.",
      "exp": {
        "name": "c1-baseline",
        "scenario": "campaign",
        "runs": 16,
        "variants": [
          {
            "name": "base"
          }
        ],
        "breakdown": [
          "job",
          "race"
        ]
      },
      "expect": [
        {
          "mean": "base",
          "metric": "winRate",
          "gte": 0.95
        },
        {
          "mean": "base",
          "metric": "weeksToWin",
          "between": [
            20,
            45
          ]
        },
        {
          "mean": "base",
          "metric": "missed",
          "lte": 0.2
        }
      ]
    },
    {
      "id": "tidiness-neutral-70",
      "intent": "Tidiness is neutral around 70: holding it at 60 changes little.",
      "exp": "tidiness",
      "expect": [
        {
          "delta": [
            "mid · tidy 60",
            "late · tidy 60"
          ],
          "metric": "total",
          "pct": 5
        }
      ]
    },
    {
      "id": "tidiness-penalty-below-30",
      "intent": "Below 30 tidiness there is a noticeable penalty (at least 10% of weekly takings), worse than at 45.",
      "exp": "tidiness",
      "expect": [
        {
          "delta": [
            "mid · tidy 25",
            "late · tidy 25"
          ],
          "metric": "total",
          "lt": "-10%",
          "sig": true
        },
        {
          "compareDelta": [
            "mid · tidy 25"
          ],
          "to": [
            "mid · tidy 45"
          ],
          "metric": "total",
          "lt": 0
        }
      ]
    },
    {
      "id": "promoter-pays",
      "intent": "A promoter fills empty rooms: in a house with idle rooms (early, Lantern / Hollow), one lady promoting instead of sitting idle brings in more than her keep (about a wage). The popularity part is soft: a house that starts well known (Hollow) grows its name more slowly with a crowd, which is fine (2026-11-17).",
      "exp": {
        "name": "promoter-value",
        "scenario": "early",
        "weeks": 12,
        "runs": 16,
        "by": {
          "start.house": [
            "lantern",
            "hollow"
          ]
        },
        "variants": [
          {
            "name": "base",
            "phasePolicy": {
              "targets": {
                "maid": 1,
                "promoter": 0
              },
              "targetsAt": 3
            },
            "mutate": {
              "job": "rest",
              "jobWho": 1,
              "force": true,
              "jobFill": true
            }
          },
          {
            "name": "+promoter",
            "phasePolicy": {
              "targets": {
                "maid": 1,
                "promoter": 0
              },
              "targetsAt": 3
            },
            "mutate": {
              "job": "promoter",
              "jobWho": 1,
              "force": true,
              "jobFill": true
            }
          }
        ],
        "columns": [
          "total",
          "net",
          "promo",
          "served",
          "turned",
          "repGain"
        ],
        "delta": [
          "total",
          "net",
          "repGain"
        ],
        "breakdown": []
      },
      "expect": [
        {
          "delta": "*",
          "metric": "total",
          "gt": 40,
          "sig": true
        },
        {
          "delta": "*",
          "metric": "repGain",
          "gt": 0,
          "soft": true
        }
      ]
    },
    {
      "id": "security-stops-incidents",
      "intent": "Security is a support job that earns her keep: one lady on security instead of sitting idle clearly cuts unhandled trouble (pushy clients + night incidents) and pays back about a wage in what she saves.",
      "exp": {
        "name": "security-value",
        "scenario": "mid",
        "weeks": 12,
        "runs": 16,
        "by": {
          "scenario": [
            "mid",
            "late"
          ]
        },
        "variants": [
          {
            "name": "base",
            "phasePolicy": {
              "security": false
            },
            "mutate": {
              "job": "rest",
              "jobWho": 1,
              "force": true
            }
          },
          {
            "name": "+security",
            "phasePolicy": {
              "security": false
            },
            "mutate": {
              "job": "security",
              "jobWho": 1,
              "force": true
            }
          }
        ],
        "columns": [
          "total",
          "net",
          "pushy",
          "unhandled",
          "incidents",
          "incHandled",
          "damage",
          "trouble",
          "lost",
          "sat",
          "repGain"
        ],
        "delta": [
          "total",
          "trouble",
          "damage",
          "sat"
        ],
        "breakdown": []
      },
      "expect": [
        {
          "delta": "*",
          "metric": "trouble",
          "lt": 0,
          "sig": true
        },
        {
          "delta": "*",
          "metric": "total",
          "gt": 40,
          "soft": true
        }
      ]
    },
    {
      "id": "demons-top-courtesans",
      "intent": "Demons are meant to be the strongest courtesans.",
      "exp": "races-courtesan",
      "expect": [
        {
          "rank": "mid · demon",
          "among": "mid · *",
          "metric": "perLady",
          "top": 1
        },
        {
          "rank": "late · demon",
          "among": "late · *",
          "metric": "perLady",
          "top": 1
        }
      ]
    },
    {
      "id": "demons-poor-off-service",
      "intent": "...but risky where services are rare: moving demons into promoter/bartender/host/security costs more than it does for humans. Soft since 2026-11-17: each race's Δ is taken against that race's own default house, and an all-demon house starts lower than an all-human one, so this comparison flips with small changes. Read it with the racejob breakdown (per-lady earnings by race and job).",
      "exp": "race-jobs",
      "expect": [
        {
          "compareDelta": [
            "demon · promoter"
          ],
          "to": [
            "human · promoter"
          ],
          "metric": "total",
          "lt": 0
        },
        {
          "compareDelta": [
            "demon · bartender"
          ],
          "to": [
            "human · bartender"
          ],
          "metric": "total",
          "lt": 0
        },
        {
          "compareDelta": [
            "demon · host"
          ],
          "to": [
            "human · host"
          ],
          "metric": "total",
          "lt": 0
        },
        {
          "compareDelta": [
            "demon · security"
          ],
          "to": [
            "human · security"
          ],
          "metric": "total",
          "lt": 0
        }
      ],
      "soft": true
    },
    {
      "id": "sam-actions-balanced",
      "intent": "Sam's spare rest-day actions (except group nights and demonstrations, which are flavor) are roughly balanced: none clears the cycle-1 debt more than ~3 weeks faster or slower than the first one listed. Every variant also takes one partner walk a week (bot walkPartners), so 'walk' measures walking with all spare AP.",
      "exp": "sam-actions-campaign",
      "expect": [
        {
          "delta": "*",
          "metric": "weeksToWin",
          "abs": 3
        }
      ]
    },
    {
      "id": "ngplus-a-bit-harder",
      "intent": "NG+ is harder than cycle 1 (a bit longer is fine): cycle 2 takes 1.0-1.5x as long, without game overs.",
      "exp": "ngplus-carry",
      "expect": [
        {
          "mean": "base",
          "metric": "ngRatio",
          "between": [
            1.0,
            1.5
          ]
        },
        {
          "mean": [
            "base",
            "*"
          ],
          "metric": "winRate",
          "gte": 0.9
        }
      ]
    },
    {
      "id": "ngplus-lovers-neutral",
      "intent": "Carrying lovers into NG+ is roughly neutral: one, three or five lovers clear the cycle within ~4 weeks of each other, so there's no need to grind walks for more.",
      "exp": "ngplus-carry",
      "expect": [
        {
          "compare": [
            "3"
          ],
          "to": [
            "1"
          ],
          "metric": "ngWeeks",
          "abs": 4
        },
        {
          "compare": [
            "5"
          ],
          "to": [
            "1"
          ],
          "metric": "ngWeeks",
          "abs": 4
        }
      ]
    },
    {
      "id": "ngplus-slow-climb",
      "soft": true,
      "intent": "Over several NG+ cycles difficulty rises slowly (later cycles at least as long as cycle 2), without game overs.",
      "exp": "ngplus-cycles",
      "expect": [
        {
          "mean": "*",
          "metric": "c5weeks",
          "gte": "@c2weeks"
        },
        {
          "mean": "*",
          "metric": "c5over",
          "lte": 0.1
        }
      ]
    },
    {
      "id": "ngpp-harder-still",
      "soft": true,
      "intent": "NG++ (Lantern Shrine) is harder still than standard NG+, but not by dragging on.",
      "exp": "ngpp",
      "expect": [
        {
          "compare": [
            "ng++ (shrine)"
          ],
          "to": [
            "ng+ (wayfarer)"
          ],
          "metric": "c2weeks",
          "gt": 0
        },
        {
          "compare": [
            "ng++ (shrine)"
          ],
          "to": [
            "ng+ (wayfarer)"
          ],
          "metric": "c2weeks",
          "lt": 15
        }
      ]
    },
    {
      "id": "cheap-houses-pay-off-faster",
      "intent": "Starter houses clear the debt faster than premium ones...",
      "exp": "houses-all",
      "expect": [
        {
          "compare": [
            "lantern",
            "onsen",
            "hollow",
            "tankard",
            "wayfarer"
          ],
          "to": [
            "castle",
            "pavilion",
            "veil",
            "sanctuary",
            "atelier"
          ],
          "metric": "weeksToWin",
          "lt": 0
        }
      ]
    },
    {
      "id": "premium-houses-earn-more-later",
      "intent": "...but premium houses earn more once built up (post-debt plateau).",
      "exp": "houses-plateau",
      "expect": [
        {
          "compare": [
            "castle",
            "pavilion",
            "veil",
            "sanctuary",
            "atelier"
          ],
          "to": [
            "lantern",
            "onsen",
            "hollow",
            "tankard",
            "wayfarer"
          ],
          "metric": "net",
          "gt": 0
        }
      ]
    }
  ]
}